/target
**/*.rs.bk
*.db
*.db-wal
*.db-shm
/blobs

# 本地 Agent 工作数据，不应进入仓库
/.workbuddy/

# 各 Agent 的隔离构建目录（避免文件锁冲突 +确保测的是当前源码）
target-lead-verify/
target-split-*/

# 各类隔离构建目录与Agent 临时目录（动态产生，统一忽略）
target-*/
.racehunt/
.vuidfix/
.perimage/
.verify-logs/

# 构建产物（8MB 可执行文件）。
# 不入库：二进制每次构建都是新 blob，历史会持续膨胀，且无法合并。
# 需要给用户分发时走 GitHub Release，而不是仓库。
/dist/

# 临时提交信息文件（用 git commit -F 绕过 shell 拦截时产生）
.git-commit-msg.txt
